# Copy to deploy/compose/.env (git-ignored) and replace every value.
# Use URL-safe passwords (they are embedded in database URLs), e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-superuser
VULNEX_OWNER_PASSWORD=change-me-owner
VULNEX_APP_PASSWORD=change-me-app
# Host port for PostgreSQL if 5432 is taken by another project.
VULNEX_DB_PORT=5432
